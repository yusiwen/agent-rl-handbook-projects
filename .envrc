# Python is managed by uv, not by nix. `uv.lock` pins the versions, `.python-version` pins the
# interpreter, so both machines run the same gate without rebuilding a shell - and the reference
# machine needs nothing installed beyond uv itself.
#
# `direnv allow` once after cloning. `uv sync` is idempotent; `--frozen` stops it re-resolving, because
# a lockfile that changes every time a shell is entered is not a lockfile.

watch_file pyproject.toml
watch_file uv.lock
watch_file .python-version

uv sync --frozen --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin
